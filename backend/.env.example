# ── AarogyaNetra API environment ─────────────────────────────────────
# Copy to `.env` and adjust. All values have safe local defaults.

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=aarogya_netra
MONGO_CONNECT_RETRIES=3
MONGO_RETRY_DELAY_SECONDS=2.0

# Security — CHANGE jwt_secret_key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-me-in-production-0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# CORS (comma-separated list of origins)
CORS_ORIGINS=["*"]

# Rate limit for prediction endpoints (per user, per minute)
PREDICTIONS_RATE_LIMIT_PER_MINUTE=100

# ML artifacts directory (relative to the backend/ working dir)
MODEL_DIR=ml_models
MAX_UPLOAD_MB=10

# App
DEBUG=false
API_V1_PREFIX=/api/v1
